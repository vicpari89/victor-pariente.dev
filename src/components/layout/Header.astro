---
import ThemeToggle from '../ui/ThemeToggle.astro';
import LangToggle from '../ui/LangToggle.astro';
import { getLangFromUrl, useTranslations, getRoute } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { key: 'nav.about',    path: getRoute('about', lang)    },
  { key: 'nav.now',      path: getRoute('now', lang)      },
  { key: 'nav.blog',     path: getRoute('blog', lang)     },
  { key: 'nav.projects', path: getRoute('projects', lang) },
  { key: 'nav.contact',  path: getRoute('contact', lang)  },
] as const;

const currentPath = Astro.url.pathname;
---
<header class="header">
  <div class="container">
    <nav class="header__nav">
      <a href={`/${lang}/`} class="header__logo">
        victor-pariente<span class="header__logo-dot">.</span>dev
      </a>

      <ul class="header__links">
        {navLinks.map(({ key, path }) => (
          <li>
            <a
              href={path}
              class={`header__link ${currentPath === path || currentPath.startsWith(path + '/') ? 'header__link--active' : ''}`}
            >
              {t(key)}
            </a>
          </li>
        ))}
      </ul>

      <div class="header__controls">
        <LangToggle />
        <ThemeToggle />
        <button
          id="nav-toggle"
          class="header__burger"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="icon icon--open" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </span>
          <span class="icon icon--close" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </span>
        </button>
      </div>
    </nav>

    <ul id="mobile-nav" class="header__mobile-nav">
      {navLinks.map(({ key, path }) => (
        <li>
          <a
            href={path}
            class={`header__link ${currentPath === path || currentPath.startsWith(path + '/') ? 'header__link--active' : ''}`}
          >
            {t(key)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const header = toggle?.closest('.header') as HTMLElement | null;
  const mobileNav = document.getElementById('mobile-nav');

  function setOpen(open: boolean) {
    if (!header || !toggle) return;
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => {
    setOpen(!header?.classList.contains('is-open'));
  });

  // Close when a link is tapped so in-page navigation feels right
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // Close if widened past the mobile breakpoint
  window.matchMedia('(min-width: 721px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .header__nav {
    display: flex;
    align-items: center;
    height: 64px;
    gap: var(--space-8);
  }

  .header__logo {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .header__logo:hover {
    text-decoration: none;
  }

  .header__logo-dot {
    color: var(--color-accent);
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    flex: 1;
    justify-content: flex-end;
  }

  .header__link {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
    transition: color 0.15s;
    white-space: nowrap;
    position: relative;
  }

  .header__link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .header__link--active {
    color: var(--color-accent);
  }

  .header__link--active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: var(--space-4);
    right: var(--space-4);
    height: 2px;
    background: var(--color-accent);
  }

  .header__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  /* ── Burger button (mobile only) ── */
  .header__burger {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    width: 34px;
    height: 34px;
    transition: color 0.15s, border-color 0.15s;
  }

  .header__burger:hover {
    color: var(--color-text);
    border-color: var(--color-muted);
  }

  .header__burger .icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header__burger .icon--close {
    display: none;
  }

  .header.is-open .header__burger .icon--open {
    display: none;
  }

  .header.is-open .header__burger .icon--close {
    display: flex;
  }

  /* ── Mobile slide-down panel ── */
  .header__mobile-nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    list-style: none;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    flex-direction: column;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.25s ease, opacity 0.2s ease;
    display: none;
  }

  .header.is-open .header__mobile-nav {
    max-height: 80vh;
    opacity: 1;
  }

  .header__mobile-nav .header__link {
    display: block;
    padding: var(--space-3) var(--space-4);
  }

  .header__mobile-nav .header__link--active::after {
    display: none;
  }

  @media (max-width: 720px) {
    .header__links {
      display: none;
    }

    .header__burger {
      display: flex;
    }

    .header__mobile-nav {
      display: flex;
    }
  }
</style>
