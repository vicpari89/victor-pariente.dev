---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---
<header class="page-head">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h1 class="page-title">{title}</h1>
  <div class="accent-rule" aria-hidden="true"></div>
  {lead && <p class="lead">{lead}</p>}
</header>
