---
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const es = lang === 'es';
const c = es ? {
  heading: 'Proyectos',
  thesis: { kind: 'Trabajo de fin de máster', status: 'En curso', title: 'Accesibilidad urbana con machine learning', text: 'Modelos que clasifican la accesibilidad de tramos de calle con datos de Albacete y Algeciras.', code: 'Código', memo: 'Memoria' },
  app: { kind: 'Aplicación web', title: 'Amigo Regala', text: 'Sorteo de amigo invisible online, gratis y sin registro.', cta: 'Abrir la aplicación' },
  gh: { kind: 'Código', title: 'GitHub', text: 'Repositorios y código de mis proyectos.', cta: 'github.com/vicpari89' },
} : {
  heading: 'Projects',
  thesis: { kind: 'Master’s thesis', status: 'In progress', title: 'Urban accessibility with machine learning', text: 'Models that classify street-section accessibility using data from Albacete and Algeciras.', code: 'Code', memo: 'Thesis' },
  app: { kind: 'Web application', title: 'Amigo Regala', text: 'A free online Secret Santa draw, with no sign-up.', cta: 'Open the app' },
  gh: { kind: 'Code', title: 'GitHub', text: 'Repositories and code from my projects.', cta: 'github.com/vicpari89' },
};
---
<section class="boxes" aria-labelledby="boxes-title">
  <h2 id="boxes-title" class="boxes__heading">{c.heading}</h2>
  <div class="boxes__grid">
    <article class="box box--wide">
      <p class="box__kind">{c.thesis.kind}<span class="box__status"><span class="dot" aria-hidden="true"></span>{c.thesis.status}</span></p>
      <h3>{c.thesis.title}</h3>
      <p class="box__text">{c.thesis.text}</p>
      <p class="box__links">
        <a href="https://github.com/vicpari89/tfm-urban-accessibility-ml/" target="_blank" rel="noopener noreferrer">{c.thesis.code} ↗</a>
        <a href="https://github.com/vicpari89/tfm-urban-accessibility-ml-thesis/" target="_blank" rel="noopener noreferrer">{c.thesis.memo} ↗</a>
      </p>
    </article>

    <article class="box box--link">
      <p class="box__kind">{c.app.kind}</p>
      <h3>{c.app.title}</h3>
      <p class="box__text">{c.app.text}</p>
      <a class="box__cta" href="https://www.amigoregala.com/" target="_blank" rel="noopener noreferrer">{c.app.cta} ↗</a>
    </article>

    <article class="box box--link">
      <p class="box__kind">{c.gh.kind}</p>
      <h3>{c.gh.title}</h3>
      <p class="box__text">{c.gh.text}</p>
      <a class="box__cta" href="https://github.com/vicpari89" target="_blank" rel="noopener noreferrer">{c.gh.cta} ↗</a>
    </article>
  </div>
</section>

<style>
  .boxes { padding-bottom: var(--space-12); }
  .boxes__heading { margin-bottom: var(--space-5); font-size: var(--text-2xl); }
  .boxes__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
  .box { position: relative; display: flex; flex-direction: column; padding: var(--space-6); border: 1px solid var(--color-text); background: var(--color-surface); transition: border-color .15s, background .15s; }
  .box--wide { grid-column: span 2; }
  .box--link { grid-column: span 1; }
  .box--link:hover, .box--link:focus-within { border-color: var(--color-accent); }
  .box__kind { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); font-family: var(--font-display); font-weight: 700; font-size: var(--text-sm); letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); }
  .box__status { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-accent-text); }
  .dot { width: 8px; height: 8px; background: var(--color-accent); }
  .box h3 { margin-top: var(--space-5); font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: .95; }
  .box__text { margin-top: var(--space-3); color: var(--color-muted); line-height: 1.55; flex: 1; }
  .box__links { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .box__links a, .box__cta { font-family: var(--font-display); font-weight: 600; font-size: var(--text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--color-link); text-decoration: none; padding: .35rem .55rem; border: 1px solid currentColor; align-self: flex-start; transition: background .15s, color .15s; }
  .box__links a:hover { background: var(--color-link); color: var(--color-bg); }
  .box__cta { margin-top: var(--space-6); border: 0; padding: 0; text-decoration: underline; text-underline-offset: .3em; }
  .box__cta::after { content: ''; position: absolute; inset: 0; }
  .box--link:hover .box__cta { color: var(--color-accent-text); }
  @media (max-width: 960px) { .boxes__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .box--wide { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .boxes__grid { grid-template-columns: 1fr; } .box { padding: var(--space-5); } .box__links a { padding: .6rem .8rem; } }
</style>
