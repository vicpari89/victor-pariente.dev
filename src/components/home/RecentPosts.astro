---
import PostCard from '../blog/PostCard.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  posts: Array<{
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
      category: string;
    };
  }>;
  lang: Lang;
}

const { posts, lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="recent-posts">
  <div class="recent-posts__header">
    <h2 class="recent-posts__title">{t('home.recent.title')}</h2>
    <a href={`/${lang}/blog`} class="recent-posts__link">{t('home.recent.viewAll')}</a>
  </div>

  {posts.length === 0 ? (
    <p class="recent-posts__empty">{t('home.recent.empty')}</p>
  ) : (
    <ul class="recent-posts__list">
      {posts.map((post) => (
        <li>
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            tags={post.data.tags}
            category={post.data.category}
            lang={lang}
          />
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .recent-posts {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border);
  }

  .recent-posts__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .recent-posts__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .recent-posts__link {
    font-size: var(--text-sm);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .recent-posts__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .recent-posts__empty {
    color: var(--color-muted);
    font-size: var(--text-sm);
    padding: var(--space-8) 0;
  }
</style>
