---
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.jpg';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const es = lang === 'es';
const role = es ? 'Ingeniero de software backend' : 'Backend software engineer';
const intro = es
  ? 'Ingeniero backend con más de 10 años de experiencia. Ahora mismo en eDreams ODIGEO, finalizando un máster de ciencia de datos.'
  : 'Backend engineer with 10+ years of experience. Currently at eDreams ODIGEO, finishing a master’s degree in data science.';
const thesis = es
  ? 'Máster en Ciencia de Datos (Universitat Oberta de Catalunya). Mi trabajo de fin de máster aplica machine learning a la accesibilidad urbana.'
  : 'Master’s in Data Science (Universitat Oberta de Catalunya). My thesis applies machine learning to urban accessibility.';
const tfm = es ? 'Trabajo de fin de máster: accesibilidad urbana' : 'Master’s thesis: urban accessibility';
---
<section class="hero">
  <div class="hero__main">
    <h1>Víctor<br />Pariente</h1>
    <p class="hero__role">{role}</p>
    <p class="hero__intro">{intro}</p>
    <p class="hero__actions">
      <a class="stamp stamp--primary" href={`/${lang}/${es ? 'proyectos' : 'projects'}`}>{tfm} →</a>
      <a class="stamp" href="https://linkedin.com/in/victor-pariente" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </p>
  </div>

  <aside class="hero__note">
    <Image src={avatar} alt={es ? 'Retrato de Víctor Pariente' : 'Portrait of Víctor Pariente'} width={600} height={600} class="hero__portrait" loading="eager" />
    <p class="hero__status"><span class="dot" aria-hidden="true"></span>{es ? 'Ahora' : 'Now'}</p>
    <p>{thesis}</p>
  </aside>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-10);
    padding: var(--space-12) 0 var(--space-16);
    margin-top: var(--space-8);
    border-top: 5px solid var(--color-accent);
  }
  h1 { font-size: clamp(4rem, 11vw, 9rem); line-height: .85; letter-spacing: -.035em; }
  .hero__role { margin-top: var(--space-6); font-family: var(--font-display); font-weight: 600; font-size: var(--text-2xl); text-transform: uppercase; letter-spacing: .02em; color: var(--color-accent-text); }
  .hero__intro { margin-top: var(--space-4); font-size: var(--text-lg); line-height: 1.6; max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-3); margin-top: var(--space-8); }
  .stamp {
    font-family: var(--font-display); font-weight: 600; font-size: var(--text-sm); letter-spacing: .08em; text-transform: uppercase;
    padding: .35rem .55rem; border: 1px solid var(--color-text); color: var(--color-text); text-decoration: none;
    transition: background .15s, color .15s, border-color .15s;
  }
  .stamp:hover { color: var(--color-bg); background: var(--color-text); }
  .stamp--primary { background: var(--color-text); color: var(--color-bg); }
  .stamp--primary:hover { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  .hero__note { border-top: 1px solid var(--color-text); padding-top: var(--space-4); font-size: var(--text-sm); color: var(--color-muted); }
  .hero__portrait { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border: 1px solid var(--color-text);  }
  .hero__status { display: flex; align-items: center; gap: var(--space-2); margin: var(--space-4) 0 var(--space-2); font-family: var(--font-display); font-weight: 700; font-size: var(--text-sm); letter-spacing: .1em; text-transform: uppercase; color: var(--color-text); }
  .dot { width: 8px; height: 8px; background: var(--color-accent); }
  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; gap: var(--space-8); }
    .hero { padding-bottom: var(--space-10); }
    .hero__note { display: grid; grid-template-columns: 96px minmax(0, 1fr); column-gap: var(--space-4); align-items: start; }
    .hero__portrait { grid-row: 1 / span 2; }
    .hero__status { margin-top: 0; }
  }
</style>
