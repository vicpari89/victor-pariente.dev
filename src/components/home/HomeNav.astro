---
import type { Lang } from '../../i18n/ui';
import { getRoute } from '../../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const es = lang === 'es';
const sections = es
  ? [['Experiencia', 'Trayectoria y forma de trabajar.', 'about'], ['Ahora', 'Lo que estoy aprendiendo.', 'now']]
  : [['Experience', 'Career and way of working.', 'about'], ['Now', 'What I am learning.', 'now']];
---
<nav class="home-nav" aria-label={es ? 'Secciones' : 'Sections'}>
  {sections.map(([title, desc, route], i) => (
    <a href={getRoute(route as 'about' | 'now' | 'projects', lang)}>
      <span class="idx">{String(i + 1).padStart(2, '0')}</span>
      <strong>{title}</strong>
      <span class="desc">{desc}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  ))}
</nav>
<style>
  .home-nav { padding-bottom: var(--space-20); border-bottom: 0; }
  a { display: grid; grid-template-columns: 58px minmax(0, 1fr) minmax(0, 1.2fr) 2rem; align-items: baseline; gap: var(--space-4); padding: var(--space-5) 0; border-top: 1px solid var(--color-text); color: var(--color-text); text-decoration: none; }
  a:last-child { border-bottom: 1px solid var(--color-text); }
  .idx { font-family: var(--font-display); font-weight: 600; letter-spacing: .08em; color: var(--color-muted); }
  strong { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 3.5vw, 2rem); text-transform: uppercase; line-height: 1; transition: color .15s; }
  .desc { color: var(--color-muted); }
  .arrow { color: var(--color-accent); text-align: right; transition: transform .15s; }
  a:hover strong { color: var(--color-accent-text); }
  a:hover .arrow { transform: translateX(4px); }
  @media (max-width: 640px) { a { grid-template-columns: 40px 1fr 1.5rem; } .desc { grid-column: 2; grid-row: 2; } .arrow { grid-row: 1; grid-column: 3; } }
</style>
