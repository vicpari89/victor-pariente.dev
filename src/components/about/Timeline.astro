---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  filter?: 'work' | 'study';
}

const { lang, filter } = Astro.props;

type EventType = 'origin' | 'study' | 'work' | 'work-current';

interface TimelineEvent {
  year: string;
  type: EventType;
  icon: string;
  title: string;
  subtitle: string;
  description?: string;
}

const events: TimelineEvent[] = lang === 'es' ? [
  {
    year: 'Medina del Campo',
    type: 'origin',
    icon: '📍',
    title: 'El punto de partida',
    subtitle: 'Valladolid, España',
    description: 'De aquí vengo.',
  },
  {
    year: '2007 – 2012',
    type: 'study',
    icon: '🎓',
    title: 'Universidad de Valladolid',
    subtitle: 'Ingeniería Técnica en Informática de Gestión',
  },
  {
    year: '2011 – 2012',
    type: 'work',
    icon: '💼',
    title: 'everis',
    subtitle: 'Programador en prácticas · Valladolid',
    description: 'Mi primer contacto con el mundo del software.',
  },
  {
    year: '2013 – 2016',
    type: 'work',
    icon: '💼',
    title: 'Bilbomatica',
    subtitle: 'Desarrollador de software · Madrid',
    description: 'Backend y frontend en proyectos para la administración pública. Java, Spring, JSF, AngularJS.',
  },
  {
    year: '2016 – 2023',
    type: 'work',
    icon: '💼',
    title: 'Profile Software Services',
    subtitle: 'Analista Programador · Madrid',
    description: 'Backend Java e integración de APIs para distintos clientes. Fui asumiendo análisis de sistemas, integración y soporte técnico para clientes corporativos.',
  },
  {
    year: '2020 – 2022',
    type: 'study',
    icon: '🎓',
    title: 'Universitat Oberta de Catalunya',
    subtitle: 'Máster en Ciencia de Datos — pendiente del TFM',
  },
  {
    year: '2023 – 2025',
    type: 'work',
    icon: '💼',
    title: 'eDreams ODIGEO',
    subtitle: 'Software Engineer · Madrid',
    description: 'Microservicios Java en alta demanda. Kafka, Docker, Google Cloud, Datadog. Ciclo completo de desarrollo en equipos ágiles.',
  },
  {
    year: '2025 →',
    type: 'work-current',
    icon: '⚡',
    title: 'eDreams ODIGEO',
    subtitle: 'Senior Software Engineer · Madrid',
    description: 'Análisis técnico y colaboración con varios equipos, desde el diseño hasta producción. Mentoring, revisiones de código — e integración activa de IA en los flujos de trabajo del equipo.',
  },
] : [
  {
    year: 'Medina del Campo',
    type: 'origin',
    icon: '📍',
    title: 'Where it all began',
    subtitle: 'Valladolid, Spain',
    description: 'That\'s where I\'m from.',
  },
  {
    year: '2007 – 2012',
    type: 'study',
    icon: '🎓',
    title: 'Universidad de Valladolid',
    subtitle: 'Technical Engineering in Computer Management',
  },
  {
    year: '2011 – 2012',
    type: 'work',
    icon: '💼',
    title: 'everis',
    subtitle: 'Junior Developer (internship) · Valladolid',
    description: 'My first contact with the software world.',
  },
  {
    year: '2013 – 2016',
    type: 'work',
    icon: '💼',
    title: 'Bilbomatica',
    subtitle: 'Software Developer · Madrid',
    description: 'Backend and frontend for public administration projects. Java, Spring, JSF, AngularJS.',
  },
  {
    year: '2016 – 2023',
    type: 'work',
    icon: '💼',
    title: 'Profile Software Services',
    subtitle: 'Analyst Developer · Madrid',
    description: 'Backend Java and API integration for various clients. Gradually took on systems analysis and technical support for corporate clients.',
  },
  {
    year: '2020 – 2022',
    type: 'study',
    icon: '🎓',
    title: 'Universitat Oberta de Catalunya',
    subtitle: 'Master\'s in Data Science — final thesis pending',
  },
  {
    year: '2023 – 2025',
    type: 'work',
    icon: '💼',
    title: 'eDreams ODIGEO',
    subtitle: 'Software Engineer · Madrid',
    description: 'Java microservices in high-demand environments. Kafka, Docker, Google Cloud, Datadog. Full development cycle in agile teams.',
  },
  {
    year: '2025 →',
    type: 'work-current',
    icon: '⚡',
    title: 'eDreams ODIGEO',
    subtitle: 'Senior Software Engineer · Madrid',
    description: 'Technical analysis and collaboration with cross-functional teams, from design to production. Mentoring, code reviews — and actively integrating AI into the team\'s development workflows.',
  },
];

const svgAttrs = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';

function iconFor(type: EventType): string {
  if (type === 'study') {
    // graduation cap
    return `<svg ${svgAttrs}><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 2 2 6 2s6-1 6-2v-5"/></svg>`;
  }
  if (type === 'origin') {
    // map pin
    return `<svg ${svgAttrs}><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`;
  }
  // briefcase — work & work-current
  return `<svg ${svgAttrs}><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>`;
}

// Filter by section and show most-recent first
const displayed =
  filter === 'work'
    ? events.filter((e) => e.type === 'work' || e.type === 'work-current').reverse()
    : filter === 'study'
      ? events.filter((e) => e.type === 'study' || e.type === 'origin').reverse()
      : events;
---
<section class="timeline">
  <div class="timeline__track">
    {displayed.map((event) => (
      <div class={`tl tl--${event.type}`}>
        <span class="tl__badge" set:html={iconFor(event.type)} aria-hidden="true" />
        <div class="tl__card">
          <span class="tl__year">{event.year}</span>
          <h3 class="tl__title">{event.title}</h3>
          <p class="tl__sub">{event.subtitle}</p>
          {event.description && (
            <p class="tl__desc">{event.description}</p>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .timeline {
    margin: var(--space-2) 0;
  }

  /* ── Track: spine on the left ── */
  .timeline__track {
    position: relative;
  }

  .timeline__track::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 17px;
    width: 2px;
    transform: translateX(-1px);
    background: var(--color-border);
  }

  .tl {
    position: relative;
    padding-left: 54px;
    margin-bottom: var(--space-5);
  }

  .tl:last-child {
    margin-bottom: 0;
  }

  /* ── Icon badge on the spine ── */
  .tl__badge {
    position: absolute;
    left: 0;
    top: 2px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    color: var(--color-muted);
    z-index: 1;
  }

  .tl__badge :global(svg) {
    width: 17px;
    height: 17px;
  }

  .tl--work .tl__badge,
  .tl--work-current .tl__badge {
    border-color: var(--color-accent);
    background: var(--color-accent-dim);
    color: var(--color-accent-text);
  }

  .tl--work-current .tl__badge {
    background: var(--color-accent);
    color: #fff;
    box-shadow: 0 0 0 4px var(--color-accent-dim);
  }

  .tl--study .tl__badge {
    border-color: var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .tl--origin .tl__badge {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  /* ── Card ── */
  .tl__card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    padding: var(--space-5);
  }

  .tl--work-current .tl__card {
    border-color: var(--color-accent);
  }

  .tl__year {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin-bottom: var(--space-1);
  }

  .tl--study .tl__year,
  .tl--origin .tl__year {
    color: var(--color-muted);
  }

  .tl__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .tl__sub {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-2);
  }

  .tl__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
  }
</style>
