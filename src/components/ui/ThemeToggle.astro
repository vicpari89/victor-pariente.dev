---
---
<button
  id="theme-toggle"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <!-- shown when on light → next is dark -->
  <span class="icon icon--moon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
    </svg>
  </span>
  <!-- shown when on dark → next is light -->
  <span class="icon icon--sun" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
    </svg>
  </span>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const html = document.documentElement;

  type Theme = 'light' | 'dark';

  function getTheme(): Theme {
    return html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  }

  function setTheme(theme: Theme) {
    html.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }

  btn?.addEventListener('click', () => {
    setTheme(getTheme() === 'light' ? 'dark' : 'light');
  });
</script>

<style>
  button {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    transition: color 0.15s, border-color 0.15s;
    width: 34px;
    height: 34px;
  }

  button:hover {
    color: var(--color-text);
    border-color: var(--color-muted);
  }

  /* Icon visibility is driven by the html[data-theme] attribute (set
     before paint in BaseLayout), so exactly one icon shows from the
     first frame — no JS, no moon+sun flash on page load. */
  .icon {
    align-items: center;
    justify-content: center;
  }

  .icon--moon { display: flex; }
  .icon--sun  { display: none; }

  :global([data-theme="dark"]) .icon--moon { display: none; }
  :global([data-theme="dark"]) .icon--sun  { display: flex; }
</style>
