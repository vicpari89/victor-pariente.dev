---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Timeline from '../../components/about/Timeline.astro';
import Skills from '../../components/about/Skills.astro';
import { useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.jpg';

const lang = 'en';
const t = useTranslations(lang);

const stats = [
  { num: '10+',        label: 'years building software' },
  { num: 'Senior SWE', label: 'at eDreams ODIGEO' },
  { num: 'Madrid',     label: 'Spain' },
];

const specialties = [
  {
    title: 'Backend engineering',
    desc: 'REST and GraphQL APIs in Java, built with care for high-demand systems.',
    tags: ['Java', 'Spring', 'REST', 'GraphQL'],
  },
  {
    title: 'Cloud & data',
    desc: 'Cloud services with real-time data and event streams.',
    tags: ['Google Cloud', 'Kubernetes', 'BigQuery', 'Kafka'],
  },
  {
    title: 'AI & agents',
    desc: 'AI as a daily tool: agents, MCP and LLMs in real workflows.',
    tags: ['Copilot', 'Gemini', 'Agents', 'MCP'],
  },
];
---
<BaseLayout title="About" description={t('meta.desc.about')} lang={lang}>
  <div class="container">
    <!-- ── Hero ── -->
    <section class="about-hero">
      <div class="about-hero__text">
        <span class="eyebrow">About me</span>
        <h1 class="page-title">Víctor Pariente</h1>
        <div class="accent-rule" aria-hidden="true"></div>
        <p class="lead">
          Backend software engineer with 10+ years of experience, now exploring how
          AI is changing the way we build software.
        </p>
      </div>
      <div class="avatar-frame">
        <div class="avatar-frame__inner">
          <Image class="avatar-frame__img" src={avatar} alt="Víctor Pariente" width={220} height={220} loading="eager" />
        </div>
      </div>
    </section>

    <!-- ── Stats ── -->
    <section class="about-stats stat-row">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat__num">{s.num}</span>
          <span class="stat__label">{s.label}</span>
        </div>
      ))}
    </section>

    <!-- ── Short bio ── -->
    <section class="about-bio">
      <p>
        I've been doing backend for 10+ years. I like things done well, but without obsessing
        over it: I'd rather have something that works and keeps moving.
      </p>
      <p>
        I try to share what I know and what I learn. I document it, in case it's useful to
        someone later (myself included).
      </p>
      <p>
        Lately I'm spending a fair bit of time on AI and agents.
      </p>
      <p>
        You can see what I'm researching and building on my <a href="/en/now">now page</a>.
      </p>
    </section>

    <!-- ── Specialties ── -->
    <section class="about-block">
      <div class="section-label">What I do</div>
      <div class="feature-grid">
        {specialties.map((c, i) => (
          <article class="spec-card card">
            <span class="spec-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="spec-card__title">{c.title}</h3>
            <p class="spec-card__desc">{c.desc}</p>
            <div class="spec-card__tags">
              {c.tags.map((t) => <span class="spec-tag">{t}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ── Experience + Skills (2 columns on desktop, tabs on mobile) ── -->
    <section class="cv">
      <input class="cv__radio" type="radio" name="cvtab" id="cv-exp" checked />
      <input class="cv__radio" type="radio" name="cvtab" id="cv-studies" />
      <input class="cv__radio" type="radio" name="cvtab" id="cv-skills" />
      <div class="cv__tabs" role="tablist">
        <label class="cv__tab" for="cv-exp">Experience</label>
        <label class="cv__tab" for="cv-studies">Studies</label>
        <label class="cv__tab" for="cv-skills">Skills</label>
      </div>
      <div class="cv__grid">
        <div class="cv__col cv__col--exp">
          <Timeline lang={lang} filter="work" />
        </div>
        <div class="cv__col cv__col--studies">
          <Timeline lang={lang} filter="study" />
        </div>
        <div class="cv__col cv__col--skills">
          <Skills lang={lang} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-16) 0 var(--space-12);
  }

  .about-stats {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .about-bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-10) 0 var(--space-16);
  }

  .about-bio p {
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text);
    max-width: 62ch;
  }

  .about-block {
    margin-bottom: var(--space-16);
  }

  /* ── Specialty cards ── */
  .spec-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color 0.15s, transform 0.15s;
  }

  .spec-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  .spec-card__num {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-accent-text);
  }

  .spec-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .spec-card__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-muted);
    flex: 1;
  }

  .spec-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .spec-tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
    padding: 0.2em 0.6em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  /* ── Experience + Skills: compact tabbed panel (all sizes) ── */
  .cv {
    margin-bottom: var(--space-16);
  }

  .cv__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .cv__tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-1);
    max-width: 440px;
    margin-bottom: var(--space-10);
    padding: var(--space-1);
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }

  .cv__tab {
    text-align: center;
    padding: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-muted);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }

  .cv__tab:hover {
    color: var(--color-text);
  }

  .cv__grid {
    max-width: var(--max-w-blog);
  }

  .cv__col {
    display: none;
  }

  #cv-exp:checked ~ .cv__grid .cv__col--exp,
  #cv-studies:checked ~ .cv__grid .cv__col--studies,
  #cv-skills:checked ~ .cv__grid .cv__col--skills {
    display: block;
  }

  #cv-exp:checked ~ .cv__tabs label[for="cv-exp"],
  #cv-studies:checked ~ .cv__tabs label[for="cv-studies"],
  #cv-skills:checked ~ .cv__tabs label[for="cv-skills"] {
    color: #fff;
    background: var(--color-accent);
  }

  /* ── Mobile ── */
  @media (max-width: 720px) {
    .about-hero {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      padding-top: var(--space-12);
    }

    .about-hero .avatar-frame {
      order: -1;
      justify-self: center;
    }

    .cv__tabs {
      max-width: none;
    }
  }
</style>
