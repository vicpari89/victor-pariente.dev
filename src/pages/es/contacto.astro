---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---
<BaseLayout title={t('contact.title')} description={t('meta.desc.contact')} lang={lang}>
  <div class="container--narrow">
    <PageHeader
      title={t('contact.title')}
      lead={t('contact.body')}
    />

    <ul class="contact-links">
      <li>
        <a href="https://linkedin.com/in/victor-pariente" target="_blank" rel="noopener noreferrer" class="contact-link">
          <strong>{t('contact.linkedin')}</strong><span>linkedin.com/in/victor-pariente</span>
        </a>
      </li>
      <li>
        <a href="https://github.com/vicpari89" target="_blank" rel="noopener noreferrer" class="contact-link">
          <strong>{t('contact.github')}</strong><span>github.com/vicpari89</span>
        </a>
      </li>
      <li>
        <a href="mailto:victor.pariente.gonzalez@gmail.com" class="contact-link">
          <strong>{t('contact.email')}</strong><span>victor.pariente.gonzalez@gmail.com</span>
        </a>
      </li>
    </ul>
  </div>
</BaseLayout>

<style>
  .contact-links {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-text);
    text-decoration: none;
  }

  .contact-link strong {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .contact-link span {
    font-size: var(--text-sm);
    color: var(--color-muted);
    overflow-wrap: anywhere;
    text-align: right;
  }

  @media (max-width: 560px) {
    .contact-link { align-items: flex-start; flex-direction: column; gap: var(--space-1); }
    .contact-link span { text-align: left; }
  }
</style>
