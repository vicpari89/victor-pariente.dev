---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Timeline from '../../components/about/Timeline.astro';
import Skills from '../../components/about/Skills.astro';
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.jpg';

const lang = 'es';
---
<BaseLayout title="Sobre mí" description="Ingeniero de software backend con más de 10 años de experiencia." lang={lang}>
  <main class="profile container">
    <header class="profile__intro">
      <Image src={avatar} alt="Víctor Pariente" width={132} height={132} loading="eager" />
      <div>
        <h1>Víctor Pariente</h1>
        <p>Ingeniero de software backend</p>
      </div>
    </header>

    <section class="profile__summary">
      <p>Trabajo en backend desde hace más de 10 años. Me gusta entender bien un problema, construir una solución útil y seguir aprendiendo de lo que ocurre en producción.</p>
      <p>Actualmente soy Senior Software Engineer en eDreams ODIGEO y estoy terminando el Máster en Ciencia de Datos de la Universitat Oberta de Catalunya.</p>
    </section>

    <section class="profile__section">
      <h2>En qué trabajo</h2>
      <dl class="profile__areas">
        <div><dt>Backend</dt><dd>APIs REST y GraphQL en Java para sistemas de alta demanda.</dd></div>
        <div><dt>Cloud y datos</dt><dd>Servicios en cloud, eventos en tiempo real y flujos de datos.</dd></div>
        <div><dt>IA aplicada</dt><dd>Agentes, MCP y LLMs integrados en flujos de trabajo reales.</dd></div>
      </dl>
    </section>

    <section class="profile__section">
      <h2>Experiencia</h2>
      <Timeline lang={lang} filter="work" />
    </section>

    <section class="profile__section">
      <h2>Formación</h2>
      <Timeline lang={lang} filter="study" />
    </section>

    <Skills lang={lang} />
  </main>
</BaseLayout>

<style>
  .profile { padding-block: clamp(4rem, 10vw, 7rem); }
  .profile__intro { display:flex; align-items:center; gap:var(--space-6); }
  .profile__intro :global(img) { border-radius:var(--radius-card); }
  h1 { font-size:clamp(2.4rem, 7vw, 4.5rem); }
  .profile__intro p { margin-top:var(--space-2); color:var(--color-muted); font-size:var(--text-lg); }
  .profile__summary { display:grid; gap:var(--space-5); margin:var(--space-12) 0; font-size:var(--text-lg); line-height:1.6; }
  .profile__section { margin-top:var(--space-16); }
  h2 { margin-bottom:var(--space-6); font-size:var(--text-2xl); }
  .profile__areas { border-top:1px solid var(--color-border); }
  .profile__areas div { display:grid; grid-template-columns:10rem 1fr; gap:var(--space-6); padding:var(--space-5) 0; border-bottom:1px solid var(--color-border); }
  dt { font-weight:600; } dd { color:var(--color-muted); }
  @media (max-width:560px) { .profile__intro { align-items:flex-start; flex-direction:column; } .profile__areas div { grid-template-columns:1fr; gap:var(--space-2); } }
</style>
