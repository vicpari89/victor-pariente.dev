---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Timeline from '../../components/about/Timeline.astro';
import Skills from '../../components/about/Skills.astro';

const lang = 'es';

const stats = [
  { num: '10+',        label: 'años construyendo software' },
  { num: 'Senior SWE', label: 'en eDreams ODIGEO' },
  { num: 'Madrid',     label: 'España' },
];

const specialties = [
  {
    title: 'Backend',
    desc: 'APIs REST y GraphQL en Java, con calidad y pensadas para alta demanda.',
    tags: ['Java', 'Spring', 'REST', 'GraphQL'],
  },
  {
    title: 'Cloud y datos',
    desc: 'Servicios desplegados en cloud, con analítica y pipelines de eventos.',
    tags: ['Google Cloud', 'Kubernetes', 'BigQuery', 'Kafka'],
  },
  {
    title: 'IA y agentes',
    desc: 'La IA como herramienta diaria: copilotos, agentes y MCP en flujos reales.',
    tags: ['Copilot', 'Gemini', 'Agentes', 'MCP'],
  },
];
---
<BaseLayout title="Sobre mí" lang={lang}>
  <div class="container">
    <!-- ── Hero ── -->
    <section class="about-hero">
      <div class="about-hero__text">
        <span class="eyebrow">Sobre mí</span>
        <h1 class="page-title">Víctor Pariente</h1>
        <div class="accent-rule" aria-hidden="true"></div>
        <p class="lead">
          Ingeniero de software backend con más de 10 años de experiencia, ahora explorando
          cómo la IA está cambiando la forma en que construimos software.
        </p>
      </div>
      <div class="avatar-frame">
        <div class="avatar-frame__inner">
          <img class="avatar-frame__img" src="/avatar.jpg" alt="Víctor Pariente" width="220" height="220" />
        </div>
      </div>
    </section>

    <!-- ── Stats ── -->
    <section class="about-stats stat-row">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat__num">{s.num}</span>
          <span class="stat__label">{s.label}</span>
        </div>
      ))}
    </section>

    <!-- ── Bio breve ── -->
    <section class="about-bio">
      <p>
        Construyo sistemas backend funcionales con calidad y de manera práctica, utilizando la IA
        como herramienta.
      </p>
      <p>
        Puedes ver qué estoy investigando y haciendo en mi <a href="/es/now">página de ahora</a>.
      </p>
    </section>

    <!-- ── Especialidades ── -->
    <section class="about-block">
      <div class="section-label">En qué me especializo</div>
      <div class="feature-grid">
        {specialties.map((c, i) => (
          <article class="spec-card card">
            <span class="spec-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="spec-card__title">{c.title}</h3>
            <p class="spec-card__desc">{c.desc}</p>
            <div class="spec-card__tags">
              {c.tags.map((t) => <span class="spec-tag">{t}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ── Experiencia + Skills (2 columnas en escritorio, pestañas en móvil) ── -->
    <section class="cv">
      <input class="cv__radio" type="radio" name="cvtab" id="cv-exp" checked />
      <input class="cv__radio" type="radio" name="cvtab" id="cv-studies" />
      <input class="cv__radio" type="radio" name="cvtab" id="cv-skills" />
      <div class="cv__tabs" role="tablist">
        <label class="cv__tab" for="cv-exp">Experiencia</label>
        <label class="cv__tab" for="cv-studies">Formación</label>
        <label class="cv__tab" for="cv-skills">Skills</label>
      </div>
      <div class="cv__grid">
        <div class="cv__col cv__col--exp">
          <Timeline lang={lang} filter="work" />
        </div>
        <div class="cv__col cv__col--studies">
          <Timeline lang={lang} filter="study" />
        </div>
        <div class="cv__col cv__col--skills">
          <Skills lang={lang} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-16) 0 var(--space-12);
  }

  .about-stats {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .about-bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-10) 0 var(--space-16);
  }

  .about-bio p {
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text);
    max-width: 62ch;
  }

  .about-block {
    margin-bottom: var(--space-16);
  }

  /* ── Tarjetas de especialidad ── */
  .spec-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color 0.15s, transform 0.15s;
  }

  .spec-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  .spec-card__num {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .spec-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .spec-card__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-muted);
    flex: 1;
  }

  .spec-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .spec-tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
    padding: 0.2em 0.6em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  /* ── Experiencia + Skills: panel compacto con pestañas (todos los tamaños) ── */
  .cv {
    margin-bottom: var(--space-16);
  }

  .cv__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .cv__tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-1);
    max-width: 440px;
    margin-bottom: var(--space-10);
    padding: var(--space-1);
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }

  .cv__tab {
    text-align: center;
    padding: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-muted);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }

  .cv__tab:hover {
    color: var(--color-text);
  }

  .cv__grid {
    max-width: var(--max-w-blog);
  }

  .cv__col {
    display: none;
  }

  #cv-exp:checked ~ .cv__grid .cv__col--exp,
  #cv-studies:checked ~ .cv__grid .cv__col--studies,
  #cv-skills:checked ~ .cv__grid .cv__col--skills {
    display: block;
  }

  #cv-exp:checked ~ .cv__tabs label[for="cv-exp"],
  #cv-studies:checked ~ .cv__tabs label[for="cv-studies"],
  #cv-skills:checked ~ .cv__tabs label[for="cv-skills"] {
    color: #fff;
    background: var(--color-accent);
  }

  /* ── Móvil ── */
  @media (max-width: 720px) {
    .about-hero {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      padding-top: var(--space-12);
    }

    .about-hero .avatar-frame {
      order: -1;
    }

    .cv__tabs {
      max-width: none;
    }
  }
</style>
